POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=eventsdb

# App running locally (python app.py); DB container is published on host port 5433:
DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@localhost:5433/eventsdb

# App running in a Docker container on the "events-net" network
# (passed with -e when running the container, see README):
# DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@postgres-events:5432/eventsdb
