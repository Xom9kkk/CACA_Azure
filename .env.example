# Copy this file to .env and fill in your own values. Never commit .env.

# Access data to PostgreSQL Azure
POSTGRES_USER=<admin_login>
POSTGRES_PASSWORD=<admin_password>
POSTGRES_DB=eventsdb
POSTGRES_PORT=5432

# ConnectionString for Flask-SQLAlchemy (Azure PostgreSQL Flexible Server, SSL required)
# Avoid @ : / # % ? in the password - they break the URL.
DATABASE_URL=postgresql+psycopg2://<admin_login>:<admin_password>@<server-name>.postgres.database.azure.com:5432/eventsdb?sslmode=require

# --- Local Docker PostgreSQL (labs 2-3) ---
# App running locally (python app.py); DB container is published on host port 5433:
# DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@localhost:5433/eventsdb
# App running in a Docker container on the "events-net" network
# (passed with -e when running the container, see README):
# DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@postgres-events:5432/eventsdb
